<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScreenSplitter.UI.Views.SettingsWindow"
        Title="Настройки ScreenSplitter"
        Width="300" Height="190"
        Background="{DynamicResource BgPanel}"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

  <StackPanel Margin="20" Spacing="14">
    <TextBlock Text="НАСТРОЙКИ"
               Foreground="{DynamicResource TextMuted}"
               FontFamily="Consolas" FontSize="10.5" LetterSpacing="1" />
    <CheckBox x:Name="StartupCheckBox"
              Content="Запускать вместе с Windows"
              Foreground="{DynamicResource TextPrimary}"
              IsCheckedChanged="OnStartupCheckedChanged" />

    <Rectangle Height="1" Fill="{DynamicResource LineHairline}" />

    <TextBlock Text="Тема оформления" Foreground="{DynamicResource TextPrimary}" FontSize="11.5" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <RadioButton x:Name="DarkThemeRadio" GroupName="Theme" Content="Тёмная"
                   Foreground="{DynamicResource TextPrimary}" IsCheckedChanged="OnThemeChanged" />
      <RadioButton x:Name="LightThemeRadio" GroupName="Theme" Content="Светлая"
                   Foreground="{DynamicResource TextPrimary}" IsCheckedChanged="OnThemeChanged" />
    </StackPanel>
  </StackPanel>
</Window>