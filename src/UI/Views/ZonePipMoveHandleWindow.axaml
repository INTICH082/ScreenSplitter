<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScreenSplitter.UI.Views.ZonePipMoveHandleWindow"
        Height="14"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        Cursor="SizeAll"
        MinWidth="1"
        MinHeight="1"
        WindowStartupLocation="Manual">

  <!-- HandleBorder — весь хит-тест drag-зоны (14px, удобно попасть курсором), фон прозрачный.
       Видимую "полосу" рисует только вложенный Pill — так ручка не выглядит тяжёлой плашкой
       поверх контента, но целиться курсором по-прежнему легко по всей высоте окна. -->
  <Border x:Name="HandleBorder"
          Background="Transparent"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased">
    <Grid>
      <Border x:Name="Pill"
              Background="{StaticResource AccentAssigned}"
              CornerRadius="3"
              Width="34"
              Height="6"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="2.5" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse Width="2" Height="2" Fill="#0B0E14" />
          <Ellipse Width="2" Height="2" Fill="#0B0E14" />
          <Ellipse Width="2" Height="2" Fill="#0B0E14" />
          <Ellipse Width="2" Height="2" Fill="#0B0E14" />
          <Ellipse Width="2" Height="2" Fill="#0B0E14" />
        </StackPanel>
      </Border>
      <Button Content="✕"
              FontSize="8"
              Padding="4,0"
              Margin="0,0,3,0"
              MinWidth="0"
              MinHeight="0"
              Background="Transparent"
              BorderThickness="0"
              Foreground="{DynamicResource TextMuted}"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Cursor="Hand"
              Click="OnCloseClicked"
              ToolTip.Tip="Закрыть это PiP-окно" />
    </Grid>
  </Border>
</Window>