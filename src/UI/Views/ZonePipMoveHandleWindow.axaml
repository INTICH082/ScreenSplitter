<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScreenSplitter.UI.Views.ZonePipMoveHandleWindow"
        Height="22"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        Cursor="SizeAll"
        WindowStartupLocation="Manual">

  <Border x:Name="HandleBorder"
          Background="{StaticResource AccentAssigned}"
          CornerRadius="6,6,0,0"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Ellipse Width="3" Height="3" Fill="#0B0E14" />
        <Ellipse Width="3" Height="3" Fill="#0B0E14" />
        <Ellipse Width="3" Height="3" Fill="#0B0E14" />
        <Ellipse Width="3" Height="3" Fill="#0B0E14" />
        <Ellipse Width="3" Height="3" Fill="#0B0E14" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="✕"
              FontSize="9"
              Padding="5,0"
              Margin="0,0,2,0"
              Background="Transparent"
              BorderThickness="0"
              Foreground="#0B0E14"
              Cursor="Hand"
              Click="OnCloseClicked"
              ToolTip.Tip="Закрыть это PiP-окно" />
    </Grid>
  </Border>
</Window>